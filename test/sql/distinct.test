query I
SELECT count(*) FROM (
  (SELECT * FROM distinct_on_rename EXCEPT ALL
   (SELECT DISTINCT ON(renamed_k%2) id,v FROM distinct_on_rename_source ORDER BY renamed_k%2,v DESC,id))
  UNION ALL
  ((SELECT DISTINCT ON(renamed_k%2) id,v FROM distinct_on_rename_source ORDER BY renamed_k%2,v DESC,id)
   EXCEPT ALL SELECT * FROM distinct_on_rename)
);
----
0
