statement ok
CREATE MATERIALIZED VIEW mv_limited AS WITH x AS(SELECT k,v FROM s ORDER BY id LIMIT 4) SELECT k,SUM(v)+1 a FROM(SELECT DISTINCT k,v FROM x)d GROUP BY k;

statement ok
CREATE MATERIALIZED VIEW mv_offset AS SELECT k,SUM(v)+1 a FROM(SELECT DISTINCT k,v FROM s ORDER BY v NULLS LAST,k NULLS LAST LIMIT 3 OFFSET 1)d GROUP BY k;

