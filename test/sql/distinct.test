# name: test/sql/distinct.test
# description: Test IVM with SELECT DISTINCT
# group: [sql]

require openivm

statement ok
SET openivm_cascade_refresh = 'off';

# Issue #154: an outer projection must not publish the inner DISTINCT's hidden
# count as one of its own output columns.
statement ok
CREATE TABLE projected_distinct_source(id INT, k INT, v INT);

statement ok
INSERT INTO projected_distinct_source VALUES
    (1, 1, 10), (2, 1, 10), (3, 1, 20), (4, 2, 30),
    (5, NULL, 40), (6, NULL, 40), (7, NULL, NULL);

statement ok
CREATE MATERIALIZED VIEW projected_distinct_mv AS
SELECT k, v FROM (SELECT DISTINCT k, v FROM projected_distinct_source) q;

statement ok
CREATE VIEW projected_distinct_expected AS
SELECT k, v FROM (SELECT DISTINCT k, v FROM projected_distinct_source) q;

# Dropping a DISTINCT key and transforming another can produce duplicate output
# rows. The outer SELECT must preserve that bag, including duplicate NULLs.
statement ok
CREATE MATERIALIZED VIEW projected_distinct_computed AS
SELECT k % 2 AS parity FROM (SELECT DISTINCT k, v FROM projected_distinct_source) q;

statement ok
CREATE VIEW projected_distinct_computed_expected AS
SELECT k % 2 AS parity FROM (SELECT DISTINCT k, v FROM projected_distinct_source) q;

# Both retain the existing affected-group incremental strategy.
query I
SELECT type FROM openivm_views ORDER BY view_name;
----
6
6

query II
SELECT * FROM projected_distinct_mv EXCEPT ALL SELECT * FROM projected_distinct_expected;
----

query II
SELECT * FROM projected_distinct_expected EXCEPT ALL SELECT * FROM projected_distinct_mv;
----

query I
SELECT * FROM projected_distinct_computed ORDER BY parity NULLS FIRST;
----
NULL
NULL
0
1
1

query I
SELECT * FROM projected_distinct_computed EXCEPT ALL SELECT * FROM projected_distinct_computed_expected;
----

query I
SELECT * FROM projected_distinct_computed_expected EXCEPT ALL SELECT * FROM projected_distinct_computed;
----

# Consolidate duplicate removals, key moves, and conflicting changes on new rows
# before refreshing either view.
statement ok
INSERT INTO projected_distinct_source VALUES (8, 1, 10), (9, 3, 50), (10, 4, 60), (11, NULL, 70);

statement ok
UPDATE projected_distinct_source SET v = 11 WHERE id = 1;

statement ok
DELETE FROM projected_distinct_source WHERE id IN (2, 3);

statement ok
UPDATE projected_distinct_source SET k = 5, v = 61 WHERE id = 10;

statement ok
DELETE FROM projected_distinct_source WHERE id = 10;

statement ok
UPDATE projected_distinct_source SET k = 1, v = 10 WHERE id = 9;

statement ok
UPDATE projected_distinct_source SET v = NULL WHERE id = 11;

statement ok
PRAGMA refresh('projected_distinct_mv');

query II
SELECT * FROM projected_distinct_mv EXCEPT ALL SELECT * FROM projected_distinct_expected;
----

query II
SELECT * FROM projected_distinct_expected EXCEPT ALL SELECT * FROM projected_distinct_mv;
----

statement ok
PRAGMA refresh('projected_distinct_computed');

query I
SELECT * FROM projected_distinct_computed EXCEPT ALL SELECT * FROM projected_distinct_computed_expected;
----

query I
SELECT * FROM projected_distinct_computed_expected EXCEPT ALL SELECT * FROM projected_distinct_computed;
----

# Remove the last occurrences of existing DISTINCT tuples and merge another
# tuple into an existing one. The computed output still has bag semantics.
statement ok
DELETE FROM projected_distinct_source WHERE id IN (5, 8, 9);

statement ok
UPDATE projected_distinct_source SET k = 2, v = 30 WHERE id = 1;

statement ok
INSERT INTO projected_distinct_source VALUES (12, NULL, 40), (13, 3, 50);

statement ok
UPDATE projected_distinct_source SET v = NULL WHERE id = 12;

statement ok
DELETE FROM projected_distinct_source WHERE id = 6;

statement ok
UPDATE projected_distinct_source SET v = 51 WHERE id = 13;

statement ok
DELETE FROM projected_distinct_source WHERE id = 13;

statement ok
PRAGMA refresh('projected_distinct_mv');

query II
SELECT * FROM projected_distinct_mv EXCEPT ALL SELECT * FROM projected_distinct_expected;
----

query II
SELECT * FROM projected_distinct_expected EXCEPT ALL SELECT * FROM projected_distinct_mv;
----

statement ok
PRAGMA refresh('projected_distinct_computed');

query I
SELECT * FROM projected_distinct_computed EXCEPT ALL SELECT * FROM projected_distinct_computed_expected;
----

query I
SELECT * FROM projected_distinct_computed_expected EXCEPT ALL SELECT * FROM projected_distinct_computed;
----

statement ok
DELETE FROM projected_distinct_source;

statement ok
PRAGMA refresh('projected_distinct_mv');

query II
SELECT * FROM projected_distinct_mv EXCEPT ALL SELECT * FROM projected_distinct_expected;
----

query II
SELECT * FROM projected_distinct_expected EXCEPT ALL SELECT * FROM projected_distinct_mv;
----

statement ok
PRAGMA refresh('projected_distinct_computed');

query I
SELECT * FROM projected_distinct_computed EXCEPT ALL SELECT * FROM projected_distinct_computed_expected;
----

query I
SELECT * FROM projected_distinct_computed_expected EXCEPT ALL SELECT * FROM projected_distinct_computed;
----

# ============================================================
# Basic DISTINCT
# ============================================================

statement ok
CREATE TABLE colors (id INT, color VARCHAR);

statement ok
INSERT INTO colors VALUES (1, 'red'), (2, 'blue'), (3, 'red'), (4, 'green');

statement ok
CREATE MATERIALIZED VIEW distinct_colors AS SELECT DISTINCT color FROM colors;

query I
SELECT * FROM distinct_colors ORDER BY color;
----
blue
green
red

# Insert duplicate — should not change DISTINCT result
statement ok
INSERT INTO colors VALUES (5, 'red'), (6, 'blue');

statement ok
PRAGMA refresh('distinct_colors');

query I
SELECT COUNT(*) FROM (SELECT DISTINCT color FROM colors EXCEPT ALL SELECT * FROM distinct_colors);
----
0

query I
SELECT COUNT(*) FROM (SELECT * FROM distinct_colors EXCEPT ALL SELECT DISTINCT color FROM colors);
----
0

# An inner DISTINCT remains inner when outer derived-table projections rename
# its key and then transform it. The computed projection has bag semantics:
# distinct source keys may map to duplicate parity rows.
statement ok
CREATE TABLE nested_distinct_input (id INT, x INT);

statement ok
INSERT INTO nested_distinct_input VALUES (1, 1), (2, 1), (3, 2), (4, 3);

statement ok
CREATE MATERIALIZED VIEW nested_distinct_projection AS
    SELECT y % 2 AS parity
    FROM (
        SELECT x AS y
        FROM (
            SELECT DISTINCT x
            FROM nested_distinct_input
        )
    );

query I
SELECT type FROM openivm_views WHERE view_name = '__openivm_mv_6d656d6f7279_6d61696e_6e65737465645f64697374696e63745f70726f6a656374696f6e_';
----
6

statement ok
UPDATE nested_distinct_input SET x = 4 WHERE id = 4;

statement ok
DELETE FROM nested_distinct_input WHERE id = 1;

statement ok
INSERT INTO nested_distinct_input VALUES (5, 5), (6, 2);

statement ok
UPDATE nested_distinct_input SET x = 6 WHERE id = 6;

statement ok
DELETE FROM nested_distinct_input WHERE id = 5;

statement ok
PRAGMA refresh('nested_distinct_projection');

query I
SELECT COUNT(*) FROM (
    SELECT * FROM nested_distinct_projection
    EXCEPT ALL
    SELECT y % 2
    FROM (
        SELECT x AS y
        FROM (
            SELECT DISTINCT x
            FROM nested_distinct_input
        )
    )
);
----
0

query I
SELECT COUNT(*) FROM (
    SELECT y % 2
    FROM (
        SELECT x AS y
        FROM (
            SELECT DISTINCT x
            FROM nested_distinct_input
        )
    )
    EXCEPT ALL
    SELECT * FROM nested_distinct_projection
);
----
0

# Insert new value
statement ok
INSERT INTO colors VALUES (7, 'yellow');

statement ok
PRAGMA refresh('distinct_colors');

query I
SELECT COUNT(*) FROM (SELECT DISTINCT color FROM colors EXCEPT ALL SELECT * FROM distinct_colors);
----
0

query I
SELECT COUNT(*) FROM (SELECT * FROM distinct_colors EXCEPT ALL SELECT DISTINCT color FROM colors);
----
0

# Delete all of one color — should remove from DISTINCT result
statement ok
DELETE FROM colors WHERE color = 'green';

statement ok
PRAGMA refresh('distinct_colors');

query I
SELECT COUNT(*) FROM (SELECT DISTINCT color FROM colors EXCEPT ALL SELECT * FROM distinct_colors);
----
0

query I
SELECT COUNT(*) FROM (SELECT * FROM distinct_colors EXCEPT ALL SELECT DISTINCT color FROM colors);
----
0

# ============================================================
# DISTINCT with multiple columns
# ============================================================

statement ok
CREATE TABLE pairs (a VARCHAR, b INT);

statement ok
INSERT INTO pairs VALUES ('x', 1), ('x', 2), ('y', 1), ('x', 1);

statement ok
CREATE MATERIALIZED VIEW distinct_pairs AS SELECT DISTINCT a, b FROM pairs;

query II
SELECT a, b FROM distinct_pairs ORDER BY a, b;
----
x	1
x	2
y	1

# Insert duplicate pair — no change
statement ok
INSERT INTO pairs VALUES ('x', 1), ('y', 1);

statement ok
PRAGMA refresh('distinct_pairs');

query I
SELECT COUNT(*) FROM (SELECT DISTINCT a, b FROM pairs EXCEPT ALL SELECT a, b FROM distinct_pairs);
----
0

# Delete one copy of a duplicate — should still exist
statement ok
DELETE FROM pairs WHERE a = 'x' AND b = 1;

statement ok
PRAGMA refresh('distinct_pairs');

# x,1 still exists in pairs (was inserted twice before, deleted once)
query I
SELECT COUNT(*) FROM (SELECT DISTINCT a, b FROM pairs EXCEPT ALL SELECT a, b FROM distinct_pairs);
----
0

query I
SELECT COUNT(*) FROM (SELECT a, b FROM distinct_pairs EXCEPT ALL SELECT DISTINCT a, b FROM pairs);
----
0

