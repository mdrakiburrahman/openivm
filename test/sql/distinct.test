statement ok
SELECT CASE WHEN EXISTS((SELECT * FROM mv_limited EXCEPT ALL SELECT * FROM (WITH x AS(SELECT k,v FROM s ORDER BY id LIMIT 4) SELECT k,SUM(v)+1 a FROM(SELECT DISTINCT k,v FROM x)d GROUP BY k) expected) UNION ALL(SELECT * FROM (WITH x AS(SELECT k,v FROM s ORDER BY id LIMIT 4) SELECT k,SUM(v)+1 a FROM(SELECT DISTINCT k,v FROM x)d GROUP BY k) expected EXCEPT ALL SELECT * FROM mv_limited)) THEN error('bag mismatch limited') ELSE true END;

statement ok
PRAGMA refresh('mv_offset');

statement ok
