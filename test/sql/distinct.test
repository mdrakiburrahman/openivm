statement ok
CREATE MATERIALIZED VIEW distinct_on_rename AS SELECT DISTINCT ON(k%2) id,v FROM distinct_on_rename_source ORDER BY k%2,v DESC,id;

statement ok
ALTER TABLE distinct_on_rename_source RENAME COLUMN k TO renamed_k;

statement ok
