statement ok
DELETE FROM dist_all_null WHERE a IS NULL AND b IS NULL;

statement ok
PRAGMA refresh('mv_dist_all_null');

query I
SELECT COUNT(*) FROM (
    SELECT DISTINCT a, b FROM dist_all_null
    EXCEPT ALL
    SELECT a, b FROM mv_dist_all_null
);
----
0

query I
SELECT COUNT(*) FROM (
    SELECT a, b FROM mv_dist_all_null
    EXCEPT ALL
    SELECT DISTINCT a, b FROM dist_all_null
);
----
0

# Insert (NULL, NULL) back — it should reappear
statement ok
INSERT INTO dist_all_null VALUES (NULL, NULL);

statement ok
PRAGMA refresh('mv_dist_all_null');

query I
SELECT COUNT(*) FROM (
    SELECT DISTINCT a, b FROM dist_all_null
    EXCEPT ALL
    SELECT a, b FROM mv_dist_all_null
);
----
0

query I
SELECT COUNT(*) FROM (
    SELECT a, b FROM mv_dist_all_null
    EXCEPT ALL
    SELECT DISTINCT a, b FROM dist_all_null
);
----
0

# ============================================================
