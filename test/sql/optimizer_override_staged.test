# name: test/sql/optimizer_override_staged.test
# description: A staged CREATE (metadata in another database) runs its program under the refresh optimizer overrides
# group: [sql]

require openivm

statement ok
SET openivm_disable_daemon = true;

statement ok
ATTACH ':memory:' AS oo_control;

statement ok
SET openivm_metadata_catalog = 'oo_control';

statement ok
CREATE TABLE oo_src(k INTEGER, v INTEGER);

statement ok
CREATE TABLE oo_keys(k INTEGER, w INTEGER);

statement ok
INSERT INTO oo_src SELECT i % 6, i FROM range(60) t(i);

statement ok
INSERT INTO oo_keys VALUES (1, 20), (2, 5), (3, 30), (5, 50);

statement ok
SET disabled_optimizers = 'filter_pushdown';

# The probe records the setting its population query was planned with. current_setting makes it a
# full-refresh view, so it is only read, never refreshed.
statement ok
CREATE MATERIALIZED VIEW oo_probe AS
 SELECT k, current_setting('disabled_optimizers') AS d, COUNT(*) AS c FROM oo_src GROUP BY k, d;

query I
SELECT DISTINCT list_sort(string_split(d, ',')) FROM oo_probe;
----
[deliminator, filter_pushdown, join_filter_pushdown]

query I
SELECT current_setting('disabled_optimizers');
----
filter_pushdown

statement ok
DROP MATERIALIZED VIEW oo_probe;

statement ok
CREATE MATERIALIZED VIEW oo_semi AS
 SELECT k, SUM(v) AS s, COUNT(*) AS c FROM oo_src WHERE k IN (SELECT k FROM oo_keys WHERE w > 10) GROUP BY k;

query I
SELECT current_setting('disabled_optimizers');
----
filter_pushdown

query I
SELECT count(*) FROM (
 (SELECT * FROM oo_semi EXCEPT ALL
  SELECT k, SUM(v), COUNT(*) FROM oo_src WHERE k IN (SELECT k FROM oo_keys WHERE w > 10) GROUP BY k)
 UNION ALL
 (SELECT k, SUM(v), COUNT(*) FROM oo_src WHERE k IN (SELECT k FROM oo_keys WHERE w > 10) GROUP BY k
  EXCEPT ALL SELECT * FROM oo_semi)
);
----
0

statement ok
INSERT INTO oo_src VALUES (1, 1000), (4, 4), (2, 2);

statement ok
DELETE FROM oo_src WHERE v = 3;

statement ok
UPDATE oo_src SET v = v + 1 WHERE k = 1;

statement ok
INSERT INTO oo_keys VALUES (4, 40);

statement ok
UPDATE oo_keys SET w = 0 WHERE k = 1;

statement ok
DELETE FROM oo_keys WHERE k = 5;

statement ok
PRAGMA refresh('oo_semi');

query I
SELECT current_setting('disabled_optimizers');
----
filter_pushdown

query I
SELECT count(*) FROM (
 (SELECT * FROM oo_semi EXCEPT ALL
  SELECT k, SUM(v), COUNT(*) FROM oo_src WHERE k IN (SELECT k FROM oo_keys WHERE w > 10) GROUP BY k)
 UNION ALL
 (SELECT k, SUM(v), COUNT(*) FROM oo_src WHERE k IN (SELECT k FROM oo_keys WHERE w > 10) GROUP BY k
  EXCEPT ALL SELECT * FROM oo_semi)
);
----
0

statement ok
SET disabled_optimizers = '';
