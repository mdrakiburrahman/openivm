# name: test/sql/issue_193_internal_output_alias.test
# description: Reject explicit openivm_ output aliases the column hider would drop (#193)
# group: [sql]

# An explicit openivm_ alias (case-sensitive, like the hider) is rejected instead of silently dropped. Other spellings
# stay visible, and unaliased source columns named openivm_* keep passing through (hidden but stored).

require openivm

statement ok
SET openivm_disable_daemon = true;

statement ok
CREATE TABLE ia_src(id INTEGER, g INTEGER, x INTEGER, openivm_raw INTEGER);

statement ok
INSERT INTO ia_src VALUES (1, 1, 10, 0), (2, 1, 20, 0), (3, 2, 30, 1);

statement error
CREATE MATERIALIZED VIEW ia_proj AS SELECT id, x AS openivm_x FROM ia_src;
----
reserved OpenIVM column 'openivm_x'

statement error
CREATE MATERIALIZED VIEW ia_agg AS SELECT g, SUM(x) AS openivm_total FROM ia_src GROUP BY g;
----
reserved OpenIVM column 'openivm_total'

statement error
CREATE MATERIALIZED VIEW ia_min AS SELECT g, MIN(x) AS openivm_target_rowid, COUNT(*) AS c FROM ia_src GROUP BY g;
----
reserved OpenIVM column 'openivm_target_rowid'

# The first UNION ALL branch names the outputs.
statement error
CREATE MATERIALIZED VIEW ia_union AS SELECT id AS openivm_id FROM ia_src UNION ALL SELECT g FROM ia_src;
----
reserved OpenIVM column 'openivm_id'

# STAR RENAME and UNION BY NAME branches name outputs explicitly too.
statement error
CREATE MATERIALIZED VIEW ia_rename AS SELECT * RENAME (x AS openivm_x) FROM ia_src;
----
reserved OpenIVM column 'openivm_x'

statement error
CREATE MATERIALIZED VIEW ia_by_name AS SELECT id, g FROM ia_src UNION ALL BY NAME SELECT id, x AS openivm_x FROM ia_src;
----
reserved OpenIVM column 'openivm_x'

query I
SELECT count(*) FROM openivm_views;
----
0

# The hider is case-sensitive, so other spellings are ordinary visible columns.
statement ok
CREATE MATERIALIZED VIEW ia_upper AS SELECT g, SUM(x) AS "OPENIVM_total", COUNT(*) AS "OpenIVM_n" FROM ia_src GROUP BY g;

statement ok
CREATE MATERIALIZED VIEW ia_renamed AS SELECT id, openivm_raw AS raw FROM ia_src;

# A later positional UNION ALL branch does not name the output.
statement ok
CREATE MATERIALIZED VIEW ia_union_later AS SELECT id FROM ia_src UNION ALL SELECT g AS openivm_g FROM ia_src;

# An unaliased source column with the prefix passes through: hidden from the view, kept in the data table.
statement ok
CREATE MATERIALIZED VIEW ia_star AS SELECT * FROM ia_src;

query I
SELECT count(*) FROM openivm_views WHERE type = 3;
----
0

query I
SELECT count(*) FROM duckdb_columns() WHERE table_name = 'ia_star' AND column_name = 'openivm_raw';
----
0

statement ok
INSERT INTO ia_src VALUES (4, 2, 40, 2), (5, 3, 50, 3);

statement ok
DELETE FROM ia_src WHERE id = 1;

statement ok
UPDATE ia_src SET x = x + 1, openivm_raw = openivm_raw + 1 WHERE g = 2;

statement ok
INSERT INTO ia_src VALUES (1, 1, 11, 5);

statement ok
PRAGMA refresh('ia_upper');

statement ok
PRAGMA refresh('ia_renamed');

statement ok
PRAGMA refresh('ia_star');

statement ok
PRAGMA refresh('ia_union_later');

query I
SELECT count(*) FROM ((SELECT * FROM ia_upper EXCEPT ALL SELECT g, SUM(x), COUNT(*) FROM ia_src GROUP BY g)
    UNION ALL (SELECT g, SUM(x), COUNT(*) FROM ia_src GROUP BY g EXCEPT ALL SELECT * FROM ia_upper));
----
0

query I
SELECT count(*) FROM ((SELECT * FROM ia_renamed EXCEPT ALL SELECT id, openivm_raw FROM ia_src)
    UNION ALL (SELECT id, openivm_raw FROM ia_src EXCEPT ALL SELECT * FROM ia_renamed));
----
0

query I
SELECT count(*) FROM ((SELECT * FROM ia_star EXCEPT ALL SELECT id, g, x FROM ia_src)
    UNION ALL (SELECT id, g, x FROM ia_src EXCEPT ALL SELECT * FROM ia_star));
----
0

query I
SELECT count(*) FROM ((SELECT * FROM ia_union_later EXCEPT ALL (SELECT id FROM ia_src UNION ALL SELECT g FROM ia_src))
    UNION ALL ((SELECT id FROM ia_src UNION ALL SELECT g FROM ia_src) EXCEPT ALL SELECT * FROM ia_union_later));
----
0
