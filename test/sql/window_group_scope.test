SELECT count(*) FROM openivm_compile_with_facts('wgs_maxed','{"target_dialect":"spark","compile_only":true,"force_view_delta_cascade":true}')
WHERE lower(sql) LIKE 'delete from %' AND lower(sql) NOT LIKE '%exists%';
----
0

