# name: test/sql/issue_206_in_unqualified.test
# description: IN / NOT IN subqueries whose select list or WHERE uses bare column names that also exist in the outer
# group: [sql]

#              table (#206). Bare names bind to the subquery table, as in SQL, instead of becoming ambiguous.

require openivm

statement ok
SET openivm_disable_daemon = true;

statement ok
CREATE TABLE it(a INTEGER, b INTEGER);

statement ok
CREATE TABLE iu(a INTEGER, c INTEGER);

statement ok
INSERT INTO it VALUES (1, 10), (2, 20), (3, 30), (NULL, 40), (5, 50);

statement ok
INSERT INTO iu VALUES (1, 5), (4, 7), (5, -1);

statement ok
CREATE MATERIALIZED VIEW in_bare AS SELECT a, b FROM it WHERE a IN (SELECT a FROM iu);

statement ok
CREATE MATERIALIZED VIEW notin_bare AS SELECT a FROM it WHERE a NOT IN (SELECT a FROM iu WHERE a IS NOT NULL);

statement ok
CREATE MATERIALIZED VIEW in_left_qualified AS SELECT a, b FROM it WHERE it.a IN (SELECT a FROM iu WHERE c > 0);

statement ok
CREATE MATERIALIZED VIEW in_aliased AS SELECT x.a, x.b FROM it x WHERE x.a IN (SELECT a FROM iu y WHERE c >= 0);

statement ok
CREATE VIEW in_bare_expected AS SELECT a, b FROM it WHERE a IN (SELECT a FROM iu);

statement ok
CREATE VIEW notin_bare_expected AS SELECT a FROM it WHERE a NOT IN (SELECT a FROM iu WHERE a IS NOT NULL);

statement ok
CREATE VIEW in_left_qualified_expected AS SELECT a, b FROM it WHERE it.a IN (SELECT a FROM iu WHERE c > 0);

statement ok
CREATE VIEW in_aliased_expected AS SELECT x.a, x.b FROM it x WHERE x.a IN (SELECT a FROM iu y WHERE c >= 0);

# All use the incremental semi/anti aux state.
query II
SELECT view_sql_name, type FROM openivm_views ORDER BY 1;
----
in_aliased	9
in_bare	9
in_left_qualified	9
notin_bare	9

loop round 0 2

# Conflicting batch on both sides before one refresh.
statement ok
INSERT INTO iu VALUES (2, 1), (3, -1), (NULL, 0);

statement ok
DELETE FROM iu WHERE a = 1 OR (a IS NULL AND ${round} = 1);

statement ok
INSERT INTO it VALUES (2, 21 + ${round}), (4, 44), (NULL, 41);

statement ok
UPDATE it SET b = b + 1 WHERE a = 3;

statement ok
UPDATE iu SET c = c + 9 WHERE a = 3;

statement ok
DELETE FROM it WHERE a = 5 AND ${round} = 1;

statement ok
INSERT INTO iu VALUES (1, ${round});

statement ok
PRAGMA refresh('in_bare');

statement ok
PRAGMA refresh('notin_bare');

statement ok
PRAGMA refresh('in_left_qualified');

statement ok
PRAGMA refresh('in_aliased');

query I
SELECT count(*) FROM ((SELECT * FROM in_bare EXCEPT ALL SELECT * FROM in_bare_expected)
    UNION ALL (SELECT * FROM in_bare_expected EXCEPT ALL SELECT * FROM in_bare));
----
0

query I
SELECT count(*) FROM ((SELECT * FROM notin_bare EXCEPT ALL SELECT * FROM notin_bare_expected)
    UNION ALL (SELECT * FROM notin_bare_expected EXCEPT ALL SELECT * FROM notin_bare));
----
0

query I
SELECT count(*) FROM ((SELECT * FROM in_left_qualified EXCEPT ALL SELECT * FROM in_left_qualified_expected)
    UNION ALL (SELECT * FROM in_left_qualified_expected EXCEPT ALL SELECT * FROM in_left_qualified));
----
0

query I
SELECT count(*) FROM ((SELECT * FROM in_aliased EXCEPT ALL SELECT * FROM in_aliased_expected)
    UNION ALL (SELECT * FROM in_aliased_expected EXCEPT ALL SELECT * FROM in_aliased));
----
0

endloop
