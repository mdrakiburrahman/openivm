# name: test/sql/issue_223_delete_indexed_source.test
# description: Tracked DELETE on PRIMARY KEY / UNIQUE sources (#223). DuckDB binds the row id first and then the
# group: [sql]

#              unique-index (or RETURNING) columns, so the DELETE carries several expressions. Debug builds asserted
#              on exactly one.

require openivm

statement ok
SET openivm_disable_daemon = true;

statement ok
CREATE TABLE pk_src(id INTEGER PRIMARY KEY, g INTEGER, v INTEGER);

statement ok
CREATE TABLE uq_src(id INTEGER, code VARCHAR UNIQUE, w INTEGER);

statement ok
INSERT INTO pk_src SELECT i, i % 4, i * 10 FROM range(1, 21) t(i);

statement ok
INSERT INTO uq_src SELECT i, 'c' || i, i FROM range(1, 21) t(i);

statement ok
CREATE MATERIALIZED VIEW pk_proj AS SELECT id, g, v FROM pk_src WHERE v > 20;

statement ok
CREATE MATERIALIZED VIEW pk_agg AS SELECT g, SUM(v) AS s, COUNT(*) AS n FROM pk_src GROUP BY g;

statement ok
CREATE MATERIALIZED VIEW uq_join AS SELECT p.g, u.code, p.v + u.w AS t FROM pk_src p JOIN uq_src u ON p.id = u.id;

query I
SELECT count(*) FROM openivm_views WHERE view_sql_name IN ('pk_proj', 'pk_agg', 'uq_join') AND type = 3;
----
0

# One conflicting batch on both indexed tables: deletes (including by the indexed column and with RETURNING),
# re-inserts of deleted keys, and updates of rows touched by other statements.
statement ok
DELETE FROM pk_src WHERE id IN (3, 5, 7);

statement ok
DELETE FROM uq_src WHERE code = 'c4';

query I
DELETE FROM pk_src WHERE id = 9 RETURNING v;
----
90

query I
DELETE FROM uq_src WHERE id = 10 RETURNING code;
----
c10

statement ok
INSERT INTO pk_src VALUES (3, 1, 33), (9, 2, 99), (25, 0, 250);

statement ok
INSERT INTO uq_src VALUES (4, 'c4', 44), (9, 'c9b', 7);

statement ok
UPDATE pk_src SET v = v + 1 WHERE id IN (3, 4, 9);

statement ok
UPDATE uq_src SET w = w * 2 WHERE id IN (4, 9, 11);

statement ok
DELETE FROM pk_src WHERE id = 25;

statement ok
DELETE FROM uq_src WHERE code IN ('c11', 'c12');

statement ok
PRAGMA refresh('pk_proj');

statement ok
PRAGMA refresh('pk_agg');

statement ok
PRAGMA refresh('uq_join');

query I
SELECT count(*) FROM ((SELECT * FROM pk_proj EXCEPT ALL SELECT id, g, v FROM pk_src WHERE v > 20)
    UNION ALL (SELECT id, g, v FROM pk_src WHERE v > 20 EXCEPT ALL SELECT * FROM pk_proj));
----
0

query I
SELECT count(*) FROM ((SELECT * FROM pk_agg EXCEPT ALL SELECT g, SUM(v), COUNT(*) FROM pk_src GROUP BY g)
    UNION ALL (SELECT g, SUM(v), COUNT(*) FROM pk_src GROUP BY g EXCEPT ALL SELECT * FROM pk_agg));
----
0

query I
SELECT count(*) FROM ((SELECT * FROM uq_join
        EXCEPT ALL SELECT p.g, u.code, p.v + u.w FROM pk_src p JOIN uq_src u ON p.id = u.id)
    UNION ALL (SELECT p.g, u.code, p.v + u.w FROM pk_src p JOIN uq_src u ON p.id = u.id
        EXCEPT ALL SELECT * FROM uq_join));
----
0

# The same DELETE shapes inside an explicit transaction.
statement ok
BEGIN TRANSACTION;

statement ok
DELETE FROM pk_src WHERE g = 1;

statement ok
DELETE FROM uq_src WHERE code = 'c2' RETURNING id;

statement ok
INSERT INTO pk_src VALUES (1, 3, 11);

statement ok
UPDATE uq_src SET w = -w WHERE id = 1;

statement ok
COMMIT;

statement ok
PRAGMA refresh('pk_proj');

statement ok
PRAGMA refresh('pk_agg');

statement ok
PRAGMA refresh('uq_join');

query I
SELECT count(*) FROM ((SELECT * FROM pk_proj EXCEPT ALL SELECT id, g, v FROM pk_src WHERE v > 20)
    UNION ALL (SELECT id, g, v FROM pk_src WHERE v > 20 EXCEPT ALL SELECT * FROM pk_proj));
----
0

query I
SELECT count(*) FROM ((SELECT * FROM pk_agg EXCEPT ALL SELECT g, SUM(v), COUNT(*) FROM pk_src GROUP BY g)
    UNION ALL (SELECT g, SUM(v), COUNT(*) FROM pk_src GROUP BY g EXCEPT ALL SELECT * FROM pk_agg));
----
0

query I
SELECT count(*) FROM ((SELECT * FROM uq_join
        EXCEPT ALL SELECT p.g, u.code, p.v + u.w FROM pk_src p JOIN uq_src u ON p.id = u.id)
    UNION ALL (SELECT p.g, u.code, p.v + u.w FROM pk_src p JOIN uq_src u ON p.id = u.id
        EXCEPT ALL SELECT * FROM uq_join));
----
0
