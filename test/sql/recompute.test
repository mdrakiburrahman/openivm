# #213: an outer-join tree is parenthesized as `FROM (t AS c LEFT JOIN ...)`. Affected
# groups must come from the delta of every scan, including the first one after `FROM (`,
# so groups of moved and deleted preserved-side rows are removed. The BIGINT/INTEGER key
# keeps these views on GROUP_RECOMPUTE; derived tables cover `FROM ((SELECT` and `FROM ((WITH`.
statement ok
CREATE TABLE lj_cust (cust BIGINT, region VARCHAR);

statement ok
CREATE TABLE lj_sale (id INTEGER, cust INTEGER, amount DOUBLE);

statement ok
CREATE TABLE lj_region (region VARCHAR, zone INTEGER);

statement ok
INSERT INTO lj_cust VALUES (1, 'a'), (2, 'b'), (3, 'a'), (4, 'c'), (5, NULL), (6, 'b');

statement ok
INSERT INTO lj_sale VALUES (1, 1, 10), (2, 1, 5), (3, 2, 20), (4, 3, 7), (5, 5, 1), (6, 6, 3), (7, 9, 100);

statement ok
INSERT INTO lj_region VALUES ('a', 1), ('b', 1), ('c', 2);

statement ok
CREATE VIEW lj_key_expected AS SELECT c.cust, c.region, COUNT(s.id) AS n, SUM(s.amount) AS tot FROM lj_cust c LEFT JOIN lj_sale s ON c.cust = s.cust GROUP BY c.cust, c.region;

statement ok
CREATE MATERIALIZED VIEW lj_key_mv AS SELECT c.cust, c.region, COUNT(s.id) AS n, SUM(s.amount) AS tot FROM lj_cust c LEFT JOIN lj_sale s ON c.cust = s.cust GROUP BY c.cust, c.region;

statement ok
CREATE VIEW lj_region_expected AS SELECT c.region, COUNT(s.id) AS n, SUM(s.amount) AS tot FROM lj_cust c LEFT JOIN lj_sale s ON c.cust = s.cust GROUP BY c.region;

statement ok
CREATE MATERIALIZED VIEW lj_region_mv AS SELECT c.region, COUNT(s.id) AS n, SUM(s.amount) AS tot FROM lj_cust c LEFT JOIN lj_sale s ON c.cust = s.cust GROUP BY c.region;

statement ok
CREATE VIEW lj_nested_expected AS SELECT c.cust, c.region, COUNT(s.id) AS n, SUM(s.amount) AS tot, COUNT(r.zone) AS zones, SUM(r.zone) AS zone_sum FROM ((lj_cust c LEFT JOIN lj_sale s ON c.cust = s.cust) LEFT JOIN lj_region r ON c.region = r.region) GROUP BY c.cust, c.region;

statement ok
CREATE MATERIALIZED VIEW lj_nested_mv AS SELECT c.cust, c.region, COUNT(s.id) AS n, SUM(s.amount) AS tot, COUNT(r.zone) AS zones, SUM(r.zone) AS zone_sum FROM ((lj_cust c LEFT JOIN lj_sale s ON c.cust = s.cust) LEFT JOIN lj_region r ON c.region = r.region) GROUP BY c.cust, c.region;

statement ok
CREATE VIEW lj_subq_expected AS SELECT c.region, COUNT(s.id) AS n, SUM(s.amount) AS tot FROM (SELECT cust, region FROM lj_cust) c LEFT JOIN lj_sale s ON c.cust = s.cust GROUP BY c.region;

statement ok
CREATE MATERIALIZED VIEW lj_subq_mv AS SELECT c.region, COUNT(s.id) AS n, SUM(s.amount) AS tot FROM (SELECT cust, region FROM lj_cust) c LEFT JOIN lj_sale s ON c.cust = s.cust GROUP BY c.region;

statement ok
CREATE VIEW lj_with_expected AS SELECT c.cust, c.region, COUNT(s.id) AS n FROM (WITH cc AS (SELECT cust, region FROM lj_cust) SELECT * FROM cc) c LEFT JOIN lj_sale s ON c.cust = s.cust GROUP BY c.cust, c.region;

statement ok
CREATE MATERIALIZED VIEW lj_with_mv AS SELECT c.cust, c.region, COUNT(s.id) AS n FROM (WITH cc AS (SELECT cust, region FROM lj_cust) SELECT * FROM cc) c LEFT JOIN lj_sale s ON c.cust = s.cust GROUP BY c.cust, c.region;

