# GROUP_RECOMPUTE measure-only updates use affected-group recompute. Aggregate
# output lineage must not be inferred from output alias text: a source column
# named v must not match unrelated revenue and savings output aliases.
statement ok
CREATE TABLE gr_measure_t(id INTEGER, k INTEGER, v DOUBLE, sales DOUBLE, costs DOUBLE, label VARCHAR);

statement ok
INSERT INTO gr_measure_t VALUES
	(1, 10, 2.5, 100.0, 40.0, 'a'),
	(2, 10, 4.0, 200.0, 70.0, 'b'),
	(3, 20, 7.0, 300.0, 90.0, 'c');

statement ok
CREATE MATERIALIZED VIEW gr_measure_mv AS
SELECT md5(CAST(k AS VARCHAR)) AS primary_key,
       k,
       COUNT(DISTINCT id) AS cd,
       SUM(v) AS value_total,
       SUM(sales) AS revenue,
       SUM(costs) AS savings
FROM gr_measure_t
GROUP BY k;

