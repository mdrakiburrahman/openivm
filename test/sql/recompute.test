statement ok
CREATE VIEW gr_prefix_expected AS
    SELECT l.grp, COUNT(*) AS cnt, SUM(l.x) AS total
    FROM gr_prefix l ANTI JOIN gr_prefix2 r ON abs(l.x - r.y) <= 1
    WHERE l.label = 'memory.main.gr_prefix' GROUP BY l.grp;

statement ok
