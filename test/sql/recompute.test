# GROUP_RECOMPUTE with many source occurrences should avoid rendering one full
# affected-key query per occurrence. The data has one row per key, so the 32-way
# self-join remains tiny while still exercising the compile-time fallback.
statement ok
SET openivm_files_path='__TEST_DIR__';

statement ok
CREATE TABLE gr_many_t(k INT, v INT);

statement ok
INSERT INTO gr_many_t VALUES (1, 10), (2, 20);

statement ok
CREATE MATERIALIZED VIEW gr_many_mv AS
SELECT t0.k, COUNT(DISTINCT t0.v) AS cd
FROM gr_many_t t0
JOIN gr_many_t t1 ON t0.k = t1.k
JOIN gr_many_t t2 ON t0.k = t2.k
JOIN gr_many_t t3 ON t0.k = t3.k
JOIN gr_many_t t4 ON t0.k = t4.k
JOIN gr_many_t t5 ON t0.k = t5.k
JOIN gr_many_t t6 ON t0.k = t6.k
JOIN gr_many_t t7 ON t0.k = t7.k
JOIN gr_many_t t8 ON t0.k = t8.k
JOIN gr_many_t t9 ON t0.k = t9.k
JOIN gr_many_t t10 ON t0.k = t10.k
JOIN gr_many_t t11 ON t0.k = t11.k
JOIN gr_many_t t12 ON t0.k = t12.k
JOIN gr_many_t t13 ON t0.k = t13.k
JOIN gr_many_t t14 ON t0.k = t14.k
JOIN gr_many_t t15 ON t0.k = t15.k
JOIN gr_many_t t16 ON t0.k = t16.k
JOIN gr_many_t t17 ON t0.k = t17.k
JOIN gr_many_t t18 ON t0.k = t18.k
JOIN gr_many_t t19 ON t0.k = t19.k
JOIN gr_many_t t20 ON t0.k = t20.k
JOIN gr_many_t t21 ON t0.k = t21.k
JOIN gr_many_t t22 ON t0.k = t22.k
JOIN gr_many_t t23 ON t0.k = t23.k
JOIN gr_many_t t24 ON t0.k = t24.k
JOIN gr_many_t t25 ON t0.k = t25.k
JOIN gr_many_t t26 ON t0.k = t26.k
JOIN gr_many_t t27 ON t0.k = t27.k
JOIN gr_many_t t28 ON t0.k = t28.k
JOIN gr_many_t t29 ON t0.k = t29.k
JOIN gr_many_t t30 ON t0.k = t30.k
JOIN gr_many_t t31 ON t0.k = t31.k
GROUP BY t0.k;

