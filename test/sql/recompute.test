# #152: old join keys can disappear from both sources before one refresh.
statement ok
CREATE TABLE gr_join_item(k INT, s VARCHAR);

statement ok
CREATE TABLE gr_join_tag(k INT, s VARCHAR);

statement ok
INSERT INTO gr_join_item VALUES (1,'p'),(2,'q'),(3,'r'),(4,'s');

statement ok
INSERT INTO gr_join_tag VALUES (1,'Vanishes'),(2,'kept'),(3,NULL),(4,'old');

statement ok
CREATE VIEW gr_join_expected AS
    SELECT t.s AS tag, COUNT(DISTINCT i.s) AS n
    FROM gr_join_item i JOIN gr_join_tag t ON i.k = t.k GROUP BY t.s;

statement ok
CREATE MATERIALIZED VIEW gr_join_mv AS
    SELECT t.s AS tag, COUNT(DISTINCT i.s) AS n
    FROM gr_join_item i JOIN gr_join_tag t ON i.k = t.k GROUP BY t.s;

statement ok
CREATE VIEW gr_join_expression_expected AS
    SELECT lower(t.s) AS tag, COUNT(DISTINCT i.s) AS n
    FROM gr_join_item i JOIN gr_join_tag t ON i.k = t.k GROUP BY lower(t.s);

statement ok
CREATE MATERIALIZED VIEW gr_join_expression_mv AS
    SELECT lower(t.s) AS tag, COUNT(DISTINCT i.s) AS n
    FROM gr_join_item i JOIN gr_join_tag t ON i.k = t.k GROUP BY lower(t.s);

statement ok
CREATE MATERIALIZED VIEW gr_join_projected_mv AS
    SELECT t.tag, COUNT(DISTINCT i.s) AS n
    FROM gr_join_item i JOIN (SELECT k, lower(s) AS tag FROM gr_join_tag) t ON i.k = t.k GROUP BY t.tag;

