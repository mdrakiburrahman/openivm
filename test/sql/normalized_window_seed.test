# name: test/sql/normalized_window_seed.test
# description: Normalizing a DISTINCT lookup key must not discard the latest-row partition lineage
# group: [sql]

require openivm

statement ok
CREATE TABLE nws_events(k INT, ts INT, tag VARCHAR);

statement ok
CREATE TABLE nws_seed(raw VARCHAR, active BOOLEAN);

statement ok
INSERT INTO nws_events VALUES (1,1,'z'),(1,2,'a'),(2,1,'a'),(3,1,''),(4,1,NULL);

statement ok
INSERT INTO nws_seed VALUES (' a ',true),('a',true),('   ',true),(NULL,true),('z',false);

statement ok
CREATE MATERIALIZED VIEW nws_latest AS
WITH ranked AS (SELECT *, row_number() OVER (PARTITION BY k ORDER BY ts DESC) AS rn FROM nws_events),
seed AS (SELECT DISTINCT nullif(trim(raw),'') AS tag FROM nws_seed WHERE active)
SELECT ranked.k, ranked.ts, seed.tag IS NOT NULL AS hit
FROM ranked LEFT JOIN seed ON ranked.tag=seed.tag WHERE rn=1;

statement ok
CREATE VIEW nws_ref AS
WITH ranked AS (SELECT *, row_number() OVER (PARTITION BY k ORDER BY ts DESC) AS rn FROM nws_events),
seed AS (SELECT DISTINCT nullif(trim(raw),'') AS tag FROM nws_seed WHERE active)
SELECT ranked.k, ranked.ts, seed.tag IS NOT NULL AS hit
FROM ranked LEFT JOIN seed ON ranked.tag=seed.tag WHERE rn=1;

query I
SELECT count(*) FROM openivm_compile_with_facts('nws_latest','{"target_dialect":"spark","compile_only":true,"force_view_delta_cascade":true}')
WHERE stmt_order=1 AND lower(sql) LIKE '%openivm_affected_%' AND lower(sql) LIKE '%openivm_delta_nws_seed%';
----
1

statement ok
DELETE FROM nws_seed WHERE raw='a';

statement ok
PRAGMA refresh('nws_latest');

query I
SELECT count(*) FROM (SELECT * FROM nws_latest EXCEPT ALL SELECT * FROM nws_ref);
----
0

query I
SELECT count(*) FROM (SELECT * FROM nws_ref EXCEPT ALL SELECT * FROM nws_latest);
----
0

query III rowsort
SELECT k,ts,hit::INT FROM nws_latest;
----
1	2	1
2	1	1
3	1	0
4	1	0

statement ok
UPDATE nws_seed SET raw=' z ' WHERE raw=' a ';

statement ok
UPDATE nws_events SET k=5 WHERE k=1 AND ts=2;

statement ok
PRAGMA refresh('nws_latest');

query I
SELECT count(*) FROM (SELECT * FROM nws_latest EXCEPT ALL SELECT * FROM nws_ref);
----
0

query I
SELECT count(*) FROM (SELECT * FROM nws_ref EXCEPT ALL SELECT * FROM nws_latest);
----
0

query III rowsort
SELECT k,ts,hit::INT FROM nws_latest;
----
1	1	1
2	1	0
3	1	0
4	1	0
5	2	0

# The join key normalization does not prove that a computed output named k is the partition key.
statement ok
CREATE MATERIALIZED VIEW nws_shadow AS
WITH ranked AS (SELECT *, row_number() OVER (PARTITION BY k ORDER BY ts DESC) AS rn FROM nws_events),
seed AS (SELECT DISTINCT nullif(trim(raw),'') AS tag FROM nws_seed WHERE active)
SELECT ranked.k + 1 AS k, seed.tag IS NOT NULL AS hit
FROM ranked LEFT JOIN seed ON ranked.tag=seed.tag WHERE rn=1;

query I
SELECT count(*) FROM openivm_compile_with_facts('nws_shadow','{"target_dialect":"spark","compile_only":true,"force_view_delta_cascade":true}')
WHERE stmt_order=1 AND lower(sql) LIKE '%openivm_affected_%';
----
0
