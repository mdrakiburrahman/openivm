query T
SELECT format('mismatched={} rewritten={}',
    (SELECT count(*) FROM (
        (SELECT * FROM lat_renamed EXCEPT ALL SELECT * FROM lat_renamed_ref) UNION ALL
        (SELECT * FROM lat_renamed_ref EXCEPT ALL SELECT * FROM lat_renamed))),
    (SELECT string_agg(p.k::VARCHAR, ',' ORDER BY p.k) FROM lat_renamed_pin p JOIN lat_renamed_rows b ON b.k = p.k WHERE b.rid <> p.rid));
----
mismatched=0 rewritten=2
