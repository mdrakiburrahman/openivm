seed AS (SELECT DISTINCT tag FROM lat_d_tags WHERE active)
SELECT ranked.k, ranked.ts, ranked.note, seed.tag IS NOT NULL AS hit
FROM ranked LEFT JOIN seed ON ranked.tag = seed.tag WHERE rn = 1;

statement ok
CREATE VIEW lat_top_two_ref AS
WITH ranked AS (SELECT *, row_number() OVER (PARTITION BY k ORDER BY ts DESC, rev) AS rn FROM lat_d_events),
seed AS (SELECT DISTINCT tag FROM lat_d_tags WHERE active)
SELECT ranked.k, ranked.ts, ranked.note, seed.tag IS NOT NULL AS hit
FROM ranked LEFT JOIN seed ON ranked.tag = seed.tag WHERE rn <= 2;

statement ok
CREATE VIEW lat_by_day_ref AS
WITH ranked AS (SELECT *, row_number() OVER (PARTITION BY k ORDER BY CAST(ts AS DATE) DESC, rev) AS rn FROM lat_d_events),
seed AS (SELECT DISTINCT tag FROM lat_d_tags WHERE active)
SELECT ranked.k, ranked.ts, ranked.note, seed.tag IS NOT NULL AS hit
