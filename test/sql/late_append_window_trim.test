# Each row is strictly older than a materialized winner by the plain timestamp yet changes its view's output
statement ok
INSERT INTO lat_d_events VALUES
    (1, '2023-06-01 00:00:00', 1, 10, 'd1 before earliest'),
    (1, '2024-02-15 10:00:00', 1, 10, 'd1 enters top two'),
    (2, '2024-03-05 07:00:00', 0, 10, 'd2 same day lower rev');

statement ok
PRAGMA refresh('lat_ascending'); PRAGMA refresh('lat_top_two'); PRAGMA refresh('lat_by_day');

query T
SELECT coalesce(string_agg(mv, ',' ORDER BY mv), 'none') FROM (
    SELECT 'ascending' AS mv FROM (
        (SELECT * FROM lat_ascending EXCEPT ALL SELECT * FROM lat_ascending_ref) UNION ALL
        (SELECT * FROM lat_ascending_ref EXCEPT ALL SELECT * FROM lat_ascending)) HAVING count(*) > 0
    UNION ALL
    SELECT 'top_two' FROM (
        (SELECT * FROM lat_top_two EXCEPT ALL SELECT * FROM lat_top_two_ref) UNION ALL
        (SELECT * FROM lat_top_two_ref EXCEPT ALL SELECT * FROM lat_top_two)) HAVING count(*) > 0
    UNION ALL
    SELECT 'by_day' FROM (
        (SELECT * FROM lat_by_day EXCEPT ALL SELECT * FROM lat_by_day_ref) UNION ALL
        (SELECT * FROM lat_by_day_ref EXCEPT ALL SELECT * FROM lat_by_day)) HAVING count(*) > 0);
----
none

