statement ok
CREATE MATERIALIZED VIEW lat_renamed AS
WITH ranked AS (SELECT *, row_number() OVER (PARTITION BY k ORDER BY ts DESC) AS rn FROM lat_r_events),
seed AS (SELECT DISTINCT tag FROM lat_r_tags WHERE active)
SELECT ranked.k, ranked.ts, ranked.note, seed.tag IS NOT NULL AS hit
FROM ranked LEFT JOIN seed ON ranked.tag = seed.tag WHERE rn = 1;

statement ok
ALTER TABLE lat_r_events RENAME COLUMN ts TO seen_at;

query I
SELECT count(*) FROM lat_program('lat_renamed')
WHERE stmt_order = 1 AND contains(sql, 'openivm_chg.seen_at < openivm_cur.ts');
----
1

statement ok
CREATE VIEW lat_renamed_ref AS
WITH ranked AS (SELECT *, row_number() OVER (PARTITION BY k ORDER BY seen_at DESC) AS rn FROM lat_r_events),
seed AS (SELECT DISTINCT tag FROM lat_r_tags WHERE active)
SELECT ranked.k, ranked.seen_at AS ts, ranked.note, seed.tag IS NOT NULL AS hit
FROM ranked LEFT JOIN seed ON ranked.tag = seed.tag WHERE rn = 1;

statement ok
CREATE VIEW lat_renamed_rows AS
SELECT k, rowid AS rid FROM openivm_data___openivm_mv_6d656d6f7279_6d61696e_6c61745f72656e616d6564_;

statement ok
CREATE TABLE lat_renamed_pin AS SELECT * FROM lat_renamed_rows;

statement ok
