# Renaming the timestamp column keeps the trim bound to the renamed source column
statement ok
CREATE TABLE lat_r_events(k INT, ts TIMESTAMP, tag BIGINT, note VARCHAR);

statement ok
CREATE TABLE lat_r_tags(tag BIGINT, active BOOLEAN);

statement ok
INSERT INTO lat_r_events VALUES (1, '2024-03-01 10:00:00', 10, 'r1 winner'), (2, '2024-03-05 08:00:00', 10, 'r2 winner');
