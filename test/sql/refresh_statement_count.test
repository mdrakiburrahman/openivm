CALL truncate_duckdb_logs();

statement ok
PRAGMA refresh('proj');

query I
SELECT count(*) <= 12 FROM duckdb_logs WHERE type = 'QueryLog' AND message NOT LIKE '%duckdb_logs%' AND message NOT LIKE 'PRAGMA refresh%';
