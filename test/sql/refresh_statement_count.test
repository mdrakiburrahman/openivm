statement ok
CALL disable_logging();

# ==========================================
# Metadata changed between refreshes is read again: CREATE OR REPLACE, ALTER, DROP of a dependent
# ==========================================

statement ok
CREATE MATERIALIZED VIEW agg_child AS SELECT k % 2 AS parity, SUM(s) AS s FROM agg GROUP BY k % 2;

statement ok
CREATE OR REPLACE MATERIALIZED VIEW agg AS SELECT k, SUM(v + 1) AS s, COUNT(*) AS c FROM a GROUP BY k;

statement ok
ALTER MATERIALIZED VIEW agg SET REFRESH EVERY '10 minutes';

statement ok
INSERT INTO a SELECT i, i % 10, i FROM range(4000, 4010) t(i);

statement ok
DELETE FROM a WHERE id % 7 = 3;

statement ok
UPDATE a SET v = v - 1, id = id + 5000 WHERE id % 10 = 4;

statement ok
PRAGMA refresh('agg');

query I
SELECT count(*) FROM (SELECT * FROM agg EXCEPT ALL SELECT k, SUM(v + 1), COUNT(*) FROM a GROUP BY k);
----
0

query I
SELECT count(*) FROM (SELECT k, SUM(v + 1), COUNT(*) FROM a GROUP BY k EXCEPT ALL SELECT * FROM agg);
----
0

# The dependent view was refreshed by the downstream cascade.
query I
SELECT count(*) FROM (SELECT * FROM agg_child EXCEPT ALL SELECT k % 2, SUM(s) FROM agg GROUP BY k % 2);
----
0

query I
SELECT count(*) FROM (SELECT k % 2, SUM(s) FROM agg GROUP BY k % 2 EXCEPT ALL SELECT * FROM agg_child);
----
0

statement ok
DROP VIEW IF EXISTS agg_child;

statement ok
INSERT INTO a VALUES (5, 5, 5), (6, 6, 6);

statement ok
DELETE FROM a WHERE id = 5;

statement ok
UPDATE a SET v = 60 WHERE id = 6;

statement ok
PRAGMA refresh('agg');

query I
SELECT count(*) FROM (SELECT * FROM agg EXCEPT ALL SELECT k, SUM(v + 1), COUNT(*) FROM a GROUP BY k);
----
0

query I
SELECT count(*) FROM (SELECT k, SUM(v + 1), COUNT(*) FROM a GROUP BY k EXCEPT ALL SELECT * FROM agg);
----
0

# ==========================================
# A view created and refreshed in one open transaction reads the caller's uncommitted metadata
# ==========================================

statement ok
BEGIN TRANSACTION;

statement ok
CREATE TABLE tx_src(id INT, g INT, v INT);

statement ok
INSERT INTO tx_src SELECT i, i % 3, i FROM range(10) t(i);

statement ok
CREATE MATERIALIZED VIEW tx_mv AS SELECT g, SUM(v) AS s, COUNT(*) AS c FROM tx_src GROUP BY g;

statement ok
INSERT INTO tx_src VALUES (20, 1, 20), (21, 2, 21);

statement ok
DELETE FROM tx_src WHERE id = 4;

statement ok
UPDATE tx_src SET v = v * 10 WHERE id = 21 OR id = 5;

statement ok
PRAGMA refresh('tx_mv');

query I
SELECT count(*) FROM (SELECT * FROM tx_mv EXCEPT ALL SELECT g, SUM(v), COUNT(*) FROM tx_src GROUP BY g);
----
0

query I
SELECT count(*) FROM (SELECT g, SUM(v), COUNT(*) FROM tx_src GROUP BY g EXCEPT ALL SELECT * FROM tx_mv);
----
0

statement ok
COMMIT;

statement ok
INSERT INTO tx_src VALUES (30, 0, 30);

statement ok
DELETE FROM tx_src WHERE id = 20;

statement ok
UPDATE tx_src SET g = 2 WHERE id = 30;

statement ok
PRAGMA refresh('tx_mv');

query I
SELECT count(*) FROM (SELECT * FROM tx_mv EXCEPT ALL SELECT g, SUM(v), COUNT(*) FROM tx_src GROUP BY g);
----
0

query I
SELECT count(*) FROM (SELECT g, SUM(v), COUNT(*) FROM tx_src GROUP BY g EXCEPT ALL SELECT * FROM tx_mv);
----
0

# An explicit-transaction refresh of a committed join view

statement ok
BEGIN TRANSACTION;

statement ok
INSERT INTO b VALUES (7, 7, 70), (8, 8, 80);

statement ok
DELETE FROM a WHERE id = 8;

statement ok
UPDATE c SET z = z + 100 WHERE id = 7;

statement ok
PRAGMA refresh('j3');

query I
SELECT count(*) FROM (SELECT * FROM j3 EXCEPT ALL SELECT a.k, SUM(a.v), COUNT(*) FROM a JOIN b ON a.id = b.id JOIN c ON b.id = c.id GROUP BY a.k);
----
0

query I
SELECT count(*) FROM (SELECT a.k, SUM(a.v), COUNT(*) FROM a JOIN b ON a.id = b.id JOIN c ON b.id = c.id GROUP BY a.k EXCEPT ALL SELECT * FROM j3);
----
0

statement ok
COMMIT;

query I
SELECT count(*) FROM (SELECT * FROM j3 EXCEPT ALL SELECT a.k, SUM(a.v), COUNT(*) FROM a JOIN b ON a.id = b.id JOIN c ON b.id = c.id GROUP BY a.k);
----
0

query I
SELECT count(*) FROM (SELECT a.k, SUM(a.v), COUNT(*) FROM a JOIN b ON a.id = b.id JOIN c ON b.id = c.id GROUP BY a.k EXCEPT ALL SELECT * FROM j3);
----
0

# ==========================================
# Attached catalog with mixed-case catalog, schema and view names
# ==========================================

statement ok
ATTACH ':memory:' AS "MixedCat";

statement ok
CREATE SCHEMA "MixedCat"."MixedSch";

statement ok
CREATE TABLE "MixedCat"."MixedSch"."Orders"(id INT, "Grp" INT, amount INT);

statement ok
CREATE TABLE "MixedCat"."MixedSch"."Items"(id INT, price INT);

statement ok
INSERT INTO "MixedCat"."MixedSch"."Orders" SELECT i, i % 4, i FROM range(40) t(i);

statement ok
INSERT INTO "MixedCat"."MixedSch"."Items" SELECT i, i * 2 FROM range(40) t(i);

statement ok
CREATE MATERIALIZED VIEW "MixedCat"."MixedSch"."OrderTotals" AS SELECT o."Grp", SUM(o.amount + i.price) AS total, COUNT(*) AS n FROM "MixedCat"."MixedSch"."Orders" o JOIN "MixedCat"."MixedSch"."Items" i ON o.id = i.id GROUP BY o."Grp";

statement ok
INSERT INTO "MixedCat"."MixedSch"."Orders" SELECT i, i % 5, i FROM range(40, 50) t(i);

statement ok
INSERT INTO "MixedCat"."MixedSch"."Items" SELECT i, i FROM range(40, 45) t(i);

statement ok
DELETE FROM "MixedCat"."MixedSch"."Orders" WHERE id % 6 = 0;

statement ok
UPDATE "MixedCat"."MixedSch"."Items" SET price = price + 1 WHERE id % 3 = 0;

statement ok
PRAGMA refresh('"MixedCat"."MixedSch"."OrderTotals"');

query I
SELECT count(*) FROM (SELECT * FROM "MixedCat"."MixedSch"."OrderTotals" EXCEPT ALL SELECT o."Grp", SUM(o.amount + i.price), COUNT(*) FROM "MixedCat"."MixedSch"."Orders" o JOIN "MixedCat"."MixedSch"."Items" i ON o.id = i.id GROUP BY o."Grp");
----
0

query I
SELECT count(*) FROM (SELECT o."Grp", SUM(o.amount + i.price), COUNT(*) FROM "MixedCat"."MixedSch"."Orders" o JOIN "MixedCat"."MixedSch"."Items" i ON o.id = i.id GROUP BY o."Grp" EXCEPT ALL SELECT * FROM "MixedCat"."MixedSch"."OrderTotals");
----
0

# The same view, named with different case.

statement ok
INSERT INTO "MixedCat"."MixedSch"."Orders" VALUES (1, 1, 100);

statement ok
DELETE FROM "MixedCat"."MixedSch"."Items" WHERE id = 2;

statement ok
UPDATE "MixedCat"."MixedSch"."Orders" SET amount = amount * 2 WHERE id = 1;

statement ok
PRAGMA refresh('mixedcat.mixedsch.ordertotals');

query I
SELECT count(*) FROM (SELECT * FROM "MixedCat"."MixedSch"."OrderTotals" EXCEPT ALL SELECT o."Grp", SUM(o.amount + i.price), COUNT(*) FROM "MixedCat"."MixedSch"."Orders" o JOIN "MixedCat"."MixedSch"."Items" i ON o.id = i.id GROUP BY o."Grp");
----
0

query I
SELECT count(*) FROM (SELECT o."Grp", SUM(o.amount + i.price), COUNT(*) FROM "MixedCat"."MixedSch"."Orders" o JOIN "MixedCat"."MixedSch"."Items" i ON o.id = i.id GROUP BY o."Grp" EXCEPT ALL SELECT * FROM "MixedCat"."MixedSch"."OrderTotals");
----
0

# ==========================================
# DuckLake join view
# ==========================================

statement ok
INSTALL ducklake FROM '{BUILD_DIRECTORY}/repository';

statement ok
LOAD ducklake;

statement ok
ATTACH '{TEST_DIR}/refresh_statement_count_lake.db' AS dl (TYPE ducklake);

statement ok
SET openivm_files_path='{TEST_DIR}';

statement ok
CREATE TABLE dl.customers (id INT, region INT);

statement ok
CREATE TABLE dl.purchases (cust_id INT, price INT);

statement ok
INSERT INTO dl.customers SELECT i, i % 3 FROM range(20) t(i);

statement ok
INSERT INTO dl.purchases SELECT i % 20, i FROM range(60) t(i);

statement ok
CREATE MATERIALIZED VIEW dl.region_sales AS SELECT c.region, SUM(p.price) AS total, COUNT(*) AS n FROM dl.customers c JOIN dl.purchases p ON c.id = p.cust_id GROUP BY c.region;

statement ok
INSERT INTO dl.purchases SELECT i % 25, i FROM range(100, 120) t(i);

statement ok
INSERT INTO dl.customers SELECT i, i % 4 FROM range(20, 25) t(i);

statement ok
DELETE FROM dl.purchases WHERE price % 7 = 0;

statement ok
UPDATE dl.customers SET region = region + 1 WHERE id % 5 = 0;

statement ok
PRAGMA refresh('dl.region_sales');

query I
SELECT count(*) FROM (SELECT * FROM dl.region_sales EXCEPT ALL SELECT c.region, SUM(p.price), COUNT(*) FROM dl.customers c JOIN dl.purchases p ON c.id = p.cust_id GROUP BY c.region);
----
0

query I
SELECT count(*) FROM (SELECT c.region, SUM(p.price), COUNT(*) FROM dl.customers c JOIN dl.purchases p ON c.id = p.cust_id GROUP BY c.region EXCEPT ALL SELECT * FROM dl.region_sales);
----
0

# Without pending DuckLake changes the refresh is skipped and the view stays correct.

statement ok
PRAGMA refresh('dl.region_sales');

query I
SELECT count(*) FROM (SELECT * FROM dl.region_sales EXCEPT ALL SELECT c.region, SUM(p.price), COUNT(*) FROM dl.customers c JOIN dl.purchases p ON c.id = p.cust_id GROUP BY c.region);
----
0

query I
SELECT count(*) FROM (SELECT c.region, SUM(p.price), COUNT(*) FROM dl.customers c JOIN dl.purchases p ON c.id = p.cust_id GROUP BY c.region EXCEPT ALL SELECT * FROM dl.region_sales);
----
0
