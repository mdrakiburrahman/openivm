# name: test/sql/refresh_statement_count.test
# description: Upper bounds on the internal SQL statements OpenIVM issues per CREATE MATERIALIZED VIEW and
# group: [sql]

#              refresh, and correctness of the once-per-refresh metadata reads those bounds rely on

require openivm

require parquet

# Every internal statement costs a parse, bind and plan, which dominates small refreshes. Each bound is
# the measured count plus 3-6 statements of slack; the counts are deterministic (delta sources are read
# in table_name order). Before metadata was read once per refresh, refreshes issued 94-136 statements
# and refreshes without changes 35-45. A count excludes the user's statement and the queries on
# duckdb_logs.

# The counts depend on these settings; pin them so a changed default cannot silently shift the bounds.
statement ok
SET openivm_disable_daemon = true;

statement ok
SET openivm_skip_empty_deltas = true;

statement ok
SET openivm_adaptive_refresh = false;

statement ok
SET openivm_refresh_mode = 'incremental';

statement ok
SET openivm_cascade_refresh = 'downstream';

statement ok
CREATE TABLE a(id INT, k INT, v INT);

statement ok
CREATE TABLE b(id INT, k INT, w INT);

statement ok
CREATE TABLE c(id INT, k INT, z INT);

statement ok
CREATE TABLE l(id INT, k INT, v INT);

statement ok
CREATE TABLE r(id INT, w INT);

statement ok
INSERT INTO a SELECT i, i % 10, i FROM range(100) t(i);

statement ok
INSERT INTO b SELECT i, i % 10, i FROM range(100) t(i);

statement ok
INSERT INTO c SELECT i, i % 10, i FROM range(100) t(i);

statement ok
INSERT INTO l SELECT i, i % 10, i FROM range(100) t(i);

statement ok
INSERT INTO r SELECT i, i FROM range(50) t(i);

# The first CREATE also creates the metadata tables; the bounds below are for later CREATEs.

statement ok
CREATE MATERIALIZED VIEW warmup AS SELECT k, COUNT(*) AS c FROM a GROUP BY k;

statement ok
CALL enable_logging('QueryLog', storage='memory');

# ==========================================
# Grouped aggregate
# ==========================================

statement ok
CALL truncate_duckdb_logs();

statement ok
CREATE MATERIALIZED VIEW agg AS SELECT k, SUM(v) AS s, COUNT(*) AS c FROM a GROUP BY k;

query I
SELECT count(*) <= 8 FROM duckdb_logs WHERE type = 'QueryLog' AND message NOT LIKE '%duckdb_logs%' AND message NOT LIKE 'CREATE MATERIALIZED VIEW%';
----
true

statement ok
INSERT INTO a SELECT i, i % 7, i * 3 FROM range(1000, 1020) t(i);

statement ok
DELETE FROM a WHERE id % 9 = 0;

statement ok
UPDATE a SET v = v + 1 WHERE id % 4 = 1;

statement ok
CALL truncate_duckdb_logs();

statement ok
PRAGMA refresh('agg');

query I
SELECT count(*) <= 35 FROM duckdb_logs WHERE type = 'QueryLog' AND message NOT LIKE '%duckdb_logs%' AND message NOT LIKE 'PRAGMA refresh%';
----
true

query I
SELECT count(*) FROM (SELECT * FROM agg EXCEPT ALL SELECT k, SUM(v), COUNT(*) FROM a GROUP BY k);
----
0

query I
SELECT count(*) FROM (SELECT k, SUM(v), COUNT(*) FROM a GROUP BY k EXCEPT ALL SELECT * FROM agg);
----
0

# Without pending changes the refresh stops after the delta activity check.

statement ok
CALL truncate_duckdb_logs();

statement ok
PRAGMA refresh('agg');

query I
SELECT count(*) <= 12 FROM duckdb_logs WHERE type = 'QueryLog' AND message NOT LIKE '%duckdb_logs%' AND message NOT LIKE 'PRAGMA refresh%';
----
true

query I
SELECT count(*) FROM (SELECT * FROM agg EXCEPT ALL SELECT k, SUM(v), COUNT(*) FROM a GROUP BY k);
----
0

query I
SELECT count(*) FROM (SELECT k, SUM(v), COUNT(*) FROM a GROUP BY k EXCEPT ALL SELECT * FROM agg);
----
0

# ==========================================
# 3-way join aggregate
# ==========================================

statement ok
CALL truncate_duckdb_logs();

statement ok
CREATE MATERIALIZED VIEW j3 AS SELECT a.k, SUM(a.v) AS s, COUNT(*) AS c FROM a JOIN b ON a.id = b.id JOIN c ON b.id = c.id GROUP BY a.k;

query I
SELECT count(*) <= 26 FROM duckdb_logs WHERE type = 'QueryLog' AND message NOT LIKE '%duckdb_logs%' AND message NOT LIKE 'CREATE MATERIALIZED VIEW%';
----
true

statement ok
INSERT INTO a SELECT i, i % 7, i * 3 FROM range(50, 60) t(i);

statement ok
DELETE FROM a WHERE id % 11 = 0;

statement ok
UPDATE a SET v = v + 2 WHERE id % 5 = 2;

statement ok
INSERT INTO b SELECT i, i % 7, i FROM range(1000, 1010) t(i);

statement ok
DELETE FROM b WHERE id % 13 = 0;

statement ok
UPDATE c SET z = z + 1 WHERE id % 3 = 0;

statement ok
CALL truncate_duckdb_logs();

statement ok
PRAGMA refresh('j3');

query I
SELECT count(*) <= 40 FROM duckdb_logs WHERE type = 'QueryLog' AND message NOT LIKE '%duckdb_logs%' AND message NOT LIKE 'PRAGMA refresh%';
----
true

query I
SELECT count(*) FROM (SELECT * FROM j3 EXCEPT ALL SELECT a.k, SUM(a.v), COUNT(*) FROM a JOIN b ON a.id = b.id JOIN c ON b.id = c.id GROUP BY a.k);
----
0

query I
SELECT count(*) FROM (SELECT a.k, SUM(a.v), COUNT(*) FROM a JOIN b ON a.id = b.id JOIN c ON b.id = c.id GROUP BY a.k EXCEPT ALL SELECT * FROM j3);
----
0

# Only one join input changed: join compilation reuses the counted activity of every leaf.

statement ok
INSERT INTO c VALUES (1, 1, 1), (2, 2, 2);

statement ok
DELETE FROM c WHERE id = 3;

statement ok
UPDATE c SET id = 4 WHERE id = 1;

statement ok
CALL truncate_duckdb_logs();

statement ok
PRAGMA refresh('j3');

query I
SELECT count(*) <= 40 FROM duckdb_logs WHERE type = 'QueryLog' AND message NOT LIKE '%duckdb_logs%' AND message NOT LIKE 'PRAGMA refresh%';
----
true

query I
SELECT count(*) FROM (SELECT * FROM j3 EXCEPT ALL SELECT a.k, SUM(a.v), COUNT(*) FROM a JOIN b ON a.id = b.id JOIN c ON b.id = c.id GROUP BY a.k);
----
0

query I
SELECT count(*) FROM (SELECT a.k, SUM(a.v), COUNT(*) FROM a JOIN b ON a.id = b.id JOIN c ON b.id = c.id GROUP BY a.k EXCEPT ALL SELECT * FROM j3);
----
0

# Without pending changes the refresh stops after the delta activity check.

statement ok
CALL truncate_duckdb_logs();

statement ok
PRAGMA refresh('j3');

query I
SELECT count(*) <= 12 FROM duckdb_logs WHERE type = 'QueryLog' AND message NOT LIKE '%duckdb_logs%' AND message NOT LIKE 'PRAGMA refresh%';
----
true

query I
SELECT count(*) FROM (SELECT * FROM j3 EXCEPT ALL SELECT a.k, SUM(a.v), COUNT(*) FROM a JOIN b ON a.id = b.id JOIN c ON b.id = c.id GROUP BY a.k);
----
0

query I
SELECT count(*) FROM (SELECT a.k, SUM(a.v), COUNT(*) FROM a JOIN b ON a.id = b.id JOIN c ON b.id = c.id GROUP BY a.k EXCEPT ALL SELECT * FROM j3);
----
0

# ==========================================
# LEFT JOIN aggregate
# ==========================================

statement ok
CALL truncate_duckdb_logs();

statement ok
CREATE MATERIALIZED VIEW lj AS SELECT l.k, SUM(r.w) AS s, COUNT(*) AS c FROM l LEFT JOIN r ON l.id = r.id GROUP BY l.k;

query I
SELECT count(*) <= 22 FROM duckdb_logs WHERE type = 'QueryLog' AND message NOT LIKE '%duckdb_logs%' AND message NOT LIKE 'CREATE MATERIALIZED VIEW%';
----
true

statement ok
INSERT INTO l SELECT i, i % 7, i * 3 FROM range(1000, 1020) t(i);

statement ok
DELETE FROM l WHERE id % 9 = 0;

statement ok
UPDATE l SET k = k + 1 WHERE id % 4 = 1;

statement ok
INSERT INTO r SELECT i, i * 2 FROM range(60, 80) t(i);

statement ok
DELETE FROM r WHERE id % 6 = 0;

statement ok
UPDATE r SET w = w + 5 WHERE id % 5 = 1;

statement ok
CALL truncate_duckdb_logs();

statement ok
PRAGMA refresh('lj');

query I
SELECT count(*) <= 40 FROM duckdb_logs WHERE type = 'QueryLog' AND message NOT LIKE '%duckdb_logs%' AND message NOT LIKE 'PRAGMA refresh%';
----
true

query I
SELECT count(*) FROM (SELECT * FROM lj EXCEPT ALL SELECT l.k, SUM(r.w), COUNT(*) FROM l LEFT JOIN r ON l.id = r.id GROUP BY l.k);
----
0

query I
SELECT count(*) FROM (SELECT l.k, SUM(r.w), COUNT(*) FROM l LEFT JOIN r ON l.id = r.id GROUP BY l.k EXCEPT ALL SELECT * FROM lj);
----
0

# Without pending changes the refresh stops after the delta activity check.

statement ok
CALL truncate_duckdb_logs();

statement ok
PRAGMA refresh('lj');

query I
SELECT count(*) <= 12 FROM duckdb_logs WHERE type = 'QueryLog' AND message NOT LIKE '%duckdb_logs%' AND message NOT LIKE 'PRAGMA refresh%';
----
true

query I
SELECT count(*) FROM (SELECT * FROM lj EXCEPT ALL SELECT l.k, SUM(r.w), COUNT(*) FROM l LEFT JOIN r ON l.id = r.id GROUP BY l.k);
----
0

query I
SELECT count(*) FROM (SELECT l.k, SUM(r.w), COUNT(*) FROM l LEFT JOIN r ON l.id = r.id GROUP BY l.k EXCEPT ALL SELECT * FROM lj);
----
0

# ==========================================
# DISTINCT aggregate
# ==========================================

statement ok
CALL truncate_duckdb_logs();

statement ok
CREATE MATERIALIZED VIEW dagg AS SELECT k, SUM(DISTINCT v) AS sd, COUNT(*) AS c FROM a GROUP BY k;

query I
SELECT count(*) <= 8 FROM duckdb_logs WHERE type = 'QueryLog' AND message NOT LIKE '%duckdb_logs%' AND message NOT LIKE 'CREATE MATERIALIZED VIEW%';
----
true

statement ok
INSERT INTO a SELECT i, i % 7, i % 5 FROM range(2000, 2020) t(i);

statement ok
DELETE FROM a WHERE id % 8 = 0;

statement ok
UPDATE a SET v = v % 3 WHERE id % 6 = 1;

statement ok
CALL truncate_duckdb_logs();

statement ok
PRAGMA refresh('dagg');

query I
SELECT count(*) <= 35 FROM duckdb_logs WHERE type = 'QueryLog' AND message NOT LIKE '%duckdb_logs%' AND message NOT LIKE 'PRAGMA refresh%';
----
true

query I
SELECT count(*) FROM (SELECT * FROM dagg EXCEPT ALL SELECT k, SUM(DISTINCT v), COUNT(*) FROM a GROUP BY k);
----
0

query I
SELECT count(*) FROM (SELECT k, SUM(DISTINCT v), COUNT(*) FROM a GROUP BY k EXCEPT ALL SELECT * FROM dagg);
----
0

# Without pending changes the refresh stops after the delta activity check.

statement ok
CALL truncate_duckdb_logs();

statement ok
PRAGMA refresh('dagg');

query I
SELECT count(*) <= 12 FROM duckdb_logs WHERE type = 'QueryLog' AND message NOT LIKE '%duckdb_logs%' AND message NOT LIKE 'PRAGMA refresh%';
----
true

query I
SELECT count(*) FROM (SELECT * FROM dagg EXCEPT ALL SELECT k, SUM(DISTINCT v), COUNT(*) FROM a GROUP BY k);
