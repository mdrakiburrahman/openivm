# name: test/sql/optimizer_override_scope.test
# description: Refresh optimizer overrides are scoped and never undo the user's disabled_optimizers setting
# group: [sql]

require openivm

statement ok
SET openivm_disable_daemon = true;

statement ok
CREATE TABLE scope_src(k INTEGER, v INTEGER);

statement ok
INSERT INTO scope_src SELECT i % 5, i FROM range(100) t(i);

statement ok
CREATE MATERIALIZED VIEW scope_mv AS SELECT k, SUM(v) AS s, COUNT(*) AS c FROM scope_src GROUP BY k;

# An autocommit refresh restores the setting it found.
statement ok
INSERT INTO scope_src VALUES (1, 1000), (7, 7);

statement ok
UPDATE scope_src SET v = v + 1 WHERE k = 2;

statement ok
DELETE FROM scope_src WHERE k = 3;

statement ok
PRAGMA refresh('scope_mv');

query I
SELECT current_setting('disabled_optimizers') = '';
----
true

query I
SELECT count(*) FROM (
 (SELECT * FROM scope_mv EXCEPT ALL SELECT k, SUM(v), COUNT(*) FROM scope_src GROUP BY k)
 UNION ALL
 (SELECT k, SUM(v), COUNT(*) FROM scope_src GROUP BY k EXCEPT ALL SELECT * FROM scope_mv)
);
----
0

# A refresh inside a transaction holds the overrides until the transaction ends.
statement ok con1
BEGIN;

statement ok con1
DELETE FROM scope_src WHERE k = 4 AND v % 2 = 0;

statement ok con1
INSERT INTO scope_src VALUES (4, 40), (9, 90);

statement ok con1
UPDATE scope_src SET v = v * 2 WHERE k = 4;

statement ok con1
PRAGMA refresh('scope_mv');

query I con2
SELECT current_setting('disabled_optimizers') LIKE '%join_filter_pushdown%';
----
true

# The user's explicit setting, made while the override is held, survives the override's release.
statement ok con2
SET disabled_optimizers = 'deliminator,filter_pushdown';

query I con1
SELECT count(*) FROM (
 (SELECT * FROM scope_mv EXCEPT ALL SELECT k, SUM(v), COUNT(*) FROM scope_src GROUP BY k)
 UNION ALL
 (SELECT k, SUM(v), COUNT(*) FROM scope_src GROUP BY k EXCEPT ALL SELECT * FROM scope_mv)
);
----
0

statement ok con1
ROLLBACK;

query I con2
SELECT current_setting('disabled_optimizers');
----
filter_pushdown,deliminator

query I
SELECT count(*) FROM (
 (SELECT * FROM scope_mv EXCEPT ALL SELECT k, SUM(v), COUNT(*) FROM scope_src GROUP BY k)
 UNION ALL
 (SELECT k, SUM(v), COUNT(*) FROM scope_src GROUP BY k EXCEPT ALL SELECT * FROM scope_mv)
);
----
0

# Committed: the user's setting also survives, and the refresh is applied.
statement ok con1
BEGIN;

statement ok con1
UPDATE scope_src SET v = v + 5 WHERE k IN (0, 1);

statement ok con1
DELETE FROM scope_src WHERE k = 0 AND v > 50;

statement ok con1
INSERT INTO scope_src VALUES (0, 3), (11, 11);

statement ok con1
PRAGMA refresh('scope_mv');

statement ok con2
SET disabled_optimizers = 'deliminator';

statement ok con1
COMMIT;

query I
SELECT current_setting('disabled_optimizers');
----
deliminator

query I
SELECT count(*) FROM (
 (SELECT * FROM scope_mv EXCEPT ALL SELECT k, SUM(v), COUNT(*) FROM scope_src GROUP BY k)
 UNION ALL
 (SELECT k, SUM(v), COUNT(*) FROM scope_src GROUP BY k EXCEPT ALL SELECT * FROM scope_mv)
);
----
0

# Without a user change in between, the overrides are removed and the user's earlier value is kept.
statement ok
SET disabled_optimizers = 'filter_pushdown';

statement ok
INSERT INTO scope_src VALUES (2, 22);

statement ok
DELETE FROM scope_src WHERE k = 11;

statement ok
PRAGMA refresh('scope_mv');

query I
SELECT current_setting('disabled_optimizers');
----
filter_pushdown

query I
SELECT count(*) FROM (
 (SELECT * FROM scope_mv EXCEPT ALL SELECT k, SUM(v), COUNT(*) FROM scope_src GROUP BY k)
 UNION ALL
 (SELECT k, SUM(v), COUNT(*) FROM scope_src GROUP BY k EXCEPT ALL SELECT * FROM scope_mv)
);
----
0

statement ok
SET disabled_optimizers = '';
