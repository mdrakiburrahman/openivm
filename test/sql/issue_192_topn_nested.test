# Finding 6: the pre-delta bag repeats tuples by weight; Spark has no scalar range(), so the program must use
# sequence() and keep the native value-identity key out.
statement ok
CREATE TABLE spark_t(id INT, y INT, iv INTERVAL);

statement ok
INSERT INTO spark_t VALUES (1, 1, INTERVAL '1 day'), (2, 2, INTERVAL '1 month'), (3, 2, INTERVAL '30 days');

statement ok
CREATE MATERIALIZED VIEW spark_topk_mv AS SELECT y, COUNT(*) AS c FROM (SELECT y, iv FROM spark_t ORDER BY id LIMIT 2) q GROUP BY y;

statement ok
INSERT INTO spark_t VALUES (0, 5, INTERVAL '2 days');

query I
SELECT CASE WHEN string_agg(sql, ' ' ORDER BY stmt_order) LIKE '%explode(CASE WHEN %sequence(CAST(1 AS BIGINT)%'
             AND string_agg(sql, ' ' ORDER BY stmt_order) NOT LIKE '%range(%'
             AND string_agg(sql, ' ' ORDER BY stmt_order) NOT LIKE '%openivm_internal_value_key%'
            THEN 1 ELSE 0 END
FROM openivm_compile_with_facts('spark_topk_mv', '{"target_dialect":"spark","compile_only":true}')
WHERE stmt_kind = 'data';
----
1

statement ok
PRAGMA refresh('spark_topk_mv');

query I
SELECT COUNT(*) FROM (
    (SELECT * FROM spark_topk_mv EXCEPT ALL SELECT y, COUNT(*) FROM (SELECT y, iv FROM spark_t ORDER BY id LIMIT 2) q GROUP BY y)
    UNION ALL
    (SELECT y, COUNT(*) FROM (SELECT y, iv FROM spark_t ORDER BY id LIMIT 2) q GROUP BY y EXCEPT ALL SELECT * FROM spark_topk_mv)
);
----
0
