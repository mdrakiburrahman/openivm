endloop

# Round 2: conflicting INSERT, UPDATE and DELETE on the same rows; ORDER BY keys move rows in and out, a transient row is inserted and deleted, and a collated value changes case only.
statement ok
INSERT INTO ins_t VALUES (-5, 99);

statement ok
UPDATE ins_t SET id = 10 WHERE id = -1;

statement ok
DELETE FROM ins_t WHERE id = -5;

statement ok
UPDATE ins_t SET y = y + 1 WHERE id IN (0, 1);

statement ok
DELETE FROM grp_t WHERE id = 0;

statement ok
UPDATE grp_t SET id = 9 WHERE id = -1;

statement ok
UPDATE grp_t SET g = 3 WHERE id = 2;

statement ok
INSERT INTO tt_t VALUES (-2, 70);

statement ok
UPDATE tt_t SET x = 1 WHERE id = -2;

statement ok
DELETE FROM tt_t WHERE id = 1;

statement ok
UPDATE agg_t SET x = x + 200 WHERE g = 2;

statement ok
DELETE FROM agg_t WHERE g = 1;

statement ok
INSERT INTO agg_t VALUES (3, -30);

statement ok
UPDATE coll_t SET s = 'A' WHERE s = 'a' AND k = 1;

statement ok
DELETE FROM coll_t WHERE k = 2 AND s = 'A';

statement ok
INSERT INTO coll_t VALUES (2, 'A', INTERVAL '30 days');

statement ok
UPDATE coll_t SET k = 5 WHERE k = 0;

foreach mv topk_ins_group topk_ins_minmax topk_ins_group_max topk_ins_proj topk_ins_sum topk_ins_count_distinct topk_ins_distinct topk_ins_having topk_grp_arg_max topk_grp_count_distinct topk_grp_having_max topk_grp_distinct_sum topk_window_in topk_window_in_sum topk_distinct_in topk_outer_inner topk_outer_inner_offset topk_agg_filter topk_agg_count topk_agg_group topk_collate topk_collate_group collate_plain

statement ok
PRAGMA refresh('{mv}');

endloop

foreach mv topk_ins_group topk_ins_minmax topk_ins_group_max topk_ins_proj topk_ins_sum topk_ins_count_distinct topk_ins_distinct topk_ins_having topk_grp_arg_max topk_grp_count_distinct topk_grp_having_max topk_grp_distinct_sum topk_window_in topk_window_in_sum topk_distinct_in topk_outer_inner topk_outer_inner_offset topk_agg_filter topk_agg_count topk_agg_group topk_collate topk_collate_group collate_plain

